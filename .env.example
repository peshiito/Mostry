# ─── Mostry · variables de entorno ───────────────────────────
# Copiá este archivo a .env (cp .env.example .env) y cambiá las claves.
# Lo leen docker-compose.yml y el backend (backend/package.json usa ../.env).

# ── General ──
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_NIVEL=debug

# ── API ──
# puerto HTTP del backend
PUERTO=3000
# producción: mostry.com.ar
DOMINIO_BASE=localhost
# producción: https (orígenes aceptados por CORS)
ORIGEN_PROTOCOLO=http

# ── MySQL (contenedor) ──
MYSQL_ROOT_PASSWORD=cambiame-root
# puerto expuesto en tu máquina
MYSQL_PUERTO_HOST=3317
DB_HOST=127.0.0.1
DB_PUERTO=3317
DB_NOMBRE=mostry
# base aparte para los tests
DB_NOMBRE_TEST=mostry_test
DB_USUARIO=mostry
DB_CLAVE=cambiame-db

# ── phpMyAdmin ──
PHPMYADMIN_PUERTO_HOST=8081

# ── Archivos S3 (local: RustFS en Docker · producción: Cloudflare R2) ──
# local: http://127.0.0.1:9000 · R2: https://<cuenta>.r2.cloudflarestorage.com
S3_ENDPOINT=http://127.0.0.1:9000
# local: us-east-1 · R2: auto
S3_REGION=us-east-1
# local: usuario/clave de RustFS (la clave, mínimo 8 caracteres) · R2: token de API
S3_ACCESS_KEY=mostry
S3_SECRET_KEY=cambiame-rustfs
# URL pública del bucket de fotos (R2: dominio público del bucket)
S3_URL_PUBLICA=http://127.0.0.1:9000/mostry-publico
# fotos y logos (lectura pública)
S3_BUCKET_PUBLICO=mostry-publico
# comprobantes (privado, solo URLs firmadas de 5 minutos)
S3_BUCKET_PRIVADO=mostry-privado
# backups de la base (privado)
S3_BUCKET_BACKUPS=mostry-backups
RUSTFS_PUERTO_API=9000
RUSTFS_PUERTO_CONSOLA=9001

# ── Mailpit (bandeja de emails de prueba) ──
MAILPIT_PUERTO_SMTP=1025
MAILPIT_PUERTO_WEB=8025

# ── Seguridad ──
# Cantidad de proxies delante de la API (0 en local; Cloudflare + Railway = 2).
# Sin esto bien configurado, el rate limit por IP no sirve.
TRUST_PROXY=0
# Secreto para HMAC de códigos por email y de recuperación (mínimo 32 caracteres).
# Generalo con: openssl rand -base64 48
SECRETO_HMAC=cambiame-por-un-secreto-largo-de-al-menos-32-caracteres
# Clave AES-256 para cifrar los secretos TOTP: 32 bytes en base64.
# Generala con: openssl rand -base64 32   (si la perdés, todos reconfiguran su TOTP)
TOTP_CLAVE_CIFRADO=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── Email (local: Mailpit · producción: Resend por SMTP) ──
SMTP_HOST=127.0.0.1
# local: 1025 · Resend: 465
SMTP_PUERTO=1025
# local: vacío · Resend: resend
SMTP_USUARIO=
# local: vacío · Resend: la API key
SMTP_CLAVE=
EMAIL_REMITENTE=Mostry <hola@mostry.com.ar>

# ── Seed (solo desarrollo) ──
# Clave de los usuarios de prueba. Si la dejás vacía, no se pueden loguear.
SEED_CLAVE=mostry-demo-2026

# ── Suscripción de Mostry (se muestran en el banner de pago) ──
MOSTRY_ALIAS=mostry.pagos
MOSTRY_TITULAR=Nombre Apellido
# Precio mensual en centavos: 1000000 = $10.000
PRECIO_MENSUAL=1000000
