meta {
  name: Registrar gasto
  type: http
  seq: 6
}

post {
  url: {{api}}/panel/gastos
  body: json
  auth: none
}

headers {
  Origin: {{origenTienda}}
  Cookie: {{cookie}}
}

body:json {
  {
    "tipo": "gasto",
    "monto": 250000,
    "medio": "transferencia",
    "detalle": "Harina 0000"
  }
}
