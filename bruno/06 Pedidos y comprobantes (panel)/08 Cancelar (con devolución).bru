meta {
  name: Cancelar (con devolución)
  type: http
  seq: 8
}

post {
  url: {{api}}/panel/pedidos/{{pedidoId}}/cancelar
  body: json
  auth: none
}

headers {
  Origin: {{origenTienda}}
  Cookie: {{cookie}}
}

body:json {
  {
    "motivo": "Lo pidió el cliente",
    "devolucion": {
      "medio": "transferencia"
    }
  }
}
