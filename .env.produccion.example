# ─────────────────────────────────────────────────────────────────────────────
# Variables de PRODUCCIÓN de Mostry. Plantilla SIN secretos: copiala a
# .env.produccion (ignorado por git) o cargá cada variable en el panel de Railway.
# Nunca subas a git el archivo con los valores reales. Guía: docs/produccion.md
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──
LOG_NIVEL=info
PUERTO=3000
DOMINIO_BASE=mostry.com.ar
# Obligatorio https en producción (la config lo exige).
ORIGEN_PROTOCOLO=https
URL_TIENDA=https://{slug}.mostry.com.ar
# Cuántos proxies hay delante de la API. Cloudflare + Railway = 2. Con 0 la API
# no arranca en producción (el límite de intentos por IP no serviría).
TRUST_PROXY=2
# Secreto para firmar códigos: generalo con  openssl rand -base64 48
SECRETO_HMAC=

# ── Base de datos (MySQL 8.4) ──
# La clave root va SOLO en el servicio de MySQL (en Railway, en sus variables),
# nunca en la API ni en el worker.
MYSQL_ROOT_PASSWORD=
DB_HOST=mysql
DB_PUERTO=3306
DB_NOMBRE=mostry
DB_USUARIO=mostry
# Generala con  openssl rand -base64 24
DB_CLAVE=

# ── Archivos: Cloudflare R2 (Panel de Cloudflare → R2 → Manage API Tokens) ──
S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PUBLICO=mostry-publico
S3_BUCKET_PRIVADO=mostry-privado
S3_BUCKET_BACKUPS=mostry-backups
# Dominio público del bucket de fotos (R2 → bucket → Settings → Custom domain).
S3_URL_PUBLICA=https://archivos.mostry.com.ar
# Carpeta de los backups automáticos: "produccion" acá, "staging" en staging.
BACKUP_ENTORNO=produccion

# ── Email: Resend por SMTP (resend.com → API Keys; el dominio tiene que estar verificado) ──
SMTP_HOST=smtp.resend.com
SMTP_PUERTO=465
SMTP_USUARIO=resend
SMTP_CLAVE=
EMAIL_REMITENTE=Mostry <hola@mostry.com.ar>

# ── Cobro del plan (lo ve cada comercio en "Suscripción") ──
MOSTRY_ALIAS=
MOSTRY_TITULAR=
# En centavos: 1000000 = $10.000
PRECIO_MENSUAL=1000000

# ── Frontend (se fijan al compilar; las usa docker-compose.prod.yml) ──
VITE_API_URL=https://api.mostry.com.ar
VITE_ORIGEN_ARCHIVOS=https://archivos.mostry.com.ar
# WhatsApp de Mostry con código de país, sin espacios: 5491112345678
VITE_WHATSAPP_MOSTRY=

# En producción NO va SEED_CLAVE: el seed no corre. El admin se crea con
#   npm run admin:crear:prod -- <email> "<nombre>"
