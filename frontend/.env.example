# Dominio base para decidir la zona por subdominio (mismo que DOMINIO_BASE del backend).
# En local: mostry.localhost (sitio), laespiga.mostry.localhost (tienda), admin.mostry.localhost
VITE_DOMINIO_BASE=mostry.localhost
# URL de la API (en local, mismo sitio que el frontend para que viaje la cookie de sesión)
VITE_API_URL=http://api.mostry.localhost:3000
# WhatsApp de Mostry (con código de país, sin +) para que los comercios avisen el pago del plan
VITE_WHATSAPP_MOSTRY=
