# ─────────────────────────────────────────────────────────────────────────────
# Prueba de la versión de PRODUCCIÓN en tu máquina (docker-compose.prueba-prod.yml).
# Mismas reglas que producción (https, proxy, sin seed), pero con RustFS y Mailpit
# de desarrollo en lugar de R2 y Resend. Copiala a .env.prueba-prod (ignorado por
# git) y completá S3_ACCESS_KEY y S3_SECRET_KEY con los valores de tu .env.
# ─────────────────────────────────────────────────────────────────────────────
ARCHIVO_ENV=.env.prueba-prod

LOG_NIVEL=info
PUERTO=3000
DOMINIO_BASE=mostry.localhost
ORIGEN_PROTOCOLO=https
URL_TIENDA=https://{slug}.mostry.localhost
# Delante de la API está Caddy (hace de Cloudflare): un proxy.
TRUST_PROXY=1
SECRETO_HMAC=prueba-local-de-produccion-no-es-un-secreto-real-0123456789

MYSQL_ROOT_PASSWORD=prueba-prod-root
DB_HOST=mysql
DB_PUERTO=3306
DB_NOMBRE=mostry
DB_USUARIO=mostry
DB_CLAVE=prueba-prod-clave

# RustFS de desarrollo (servicio "rustfs" de la red mostry_default).
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PUBLICO=mostry-publico
S3_BUCKET_PRIVADO=mostry-privado
S3_BUCKET_BACKUPS=mostry-backups
S3_URL_PUBLICA=https://archivos.mostry.localhost/mostry-publico
BACKUP_ENTORNO=prueba-local

# Mailpit de desarrollo: los mails se ven en http://localhost:8025
SMTP_HOST=mailpit
SMTP_PUERTO=1025
EMAIL_REMITENTE=Mostry <hola@mostry.com.ar>

MOSTRY_ALIAS=mostry.pagos
MOSTRY_TITULAR=Pedro Báez
PRECIO_MENSUAL=1000000

VITE_API_URL=https://api.mostry.localhost
VITE_ORIGEN_ARCHIVOS=https://archivos.mostry.localhost
VITE_WHATSAPP_MOSTRY=5491125303909
